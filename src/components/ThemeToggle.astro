<button
  class="theme-toggle"
  id="theme-toggle"
  type="button"
  aria-label="Temayı değiştir"
>
  <span class="icon" aria-hidden="true"></span>
  <span class="label"></span>
</button>

<style is:global>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 7px 0;
    background: transparent;
    color: hsl(var(--theme-text-muted));
    border: 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .theme-toggle:hover {
    border-color: hsl(var(--theme-accent));
    color: hsl(var(--theme-accent));
  }
  .theme-toggle:focus-visible {
    outline: 2px solid hsl(var(--theme-accent));
    outline-offset: 3px;
  }

  .theme-toggle .icon {
    display: inline-block;
    width: 1em;
    font-size: 13px;
    margin-right: 6px;
    text-align: center;
    transform: translateY(-1px);
  }
  .theme-toggle .icon::before {
    content: "☾";
  }
  [data-theme="dark"] .theme-toggle .icon::before {
    content: "☀";
  }

  .theme-toggle .label {
    display: inline-block;
    min-width: 2.6em;
    text-align: left;
  }
  .theme-toggle .label::before {
    content: "Koyu";
  }
  [data-theme="dark"] .theme-toggle .label::before {
    content: "Açık";
  }
</style>

<script>
  const r = document.documentElement;
  const btn = document.getElementById(
    "theme-toggle",
  ) as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener("click", () => {
      const next = r.dataset.theme === "dark" ? "light" : "dark";
      r.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      document.dispatchEvent(
        new CustomEvent("theme-change", { detail: { theme: next } }),
      );
    });
  }
</script>
