---
import { getAllPosts, getPostSortDate, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { formatRailDate, formatStampDate } from "@/utils/date";
import { absoluteUrl, withBase } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const allPosts = sortMDByDate(await getAllPosts());
const featured = allPosts[0];
const rest = allPosts.slice(1, 5);
const profile = siteConfig.profile;
const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
const sameAs = [
  profile?.github,
  profile?.linkedin,
  profile?.twitter,
  profile?.instagram,
].filter((url): url is string => Boolean(url));
const pageTitle = "Kod yazmak başlangıç. Asıl mesele üretim.";
const intro =
  "Python ve backend sistemleri geliştirirken karşılaştığım problemleri, verdiğim kararları ve tekrar dönmek istediğim çözümleri burada biriktiriyorum.";
---

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl("/")}#website`,
    url: siteUrl("/"),
    name: siteConfig.title,
    alternateName: pageTitle,
    description: siteConfig.description,
    inLanguage: siteConfig.lang,
    publisher: { "@id": `${siteUrl("/")}#person` },
  }}
/>

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl("/")}#person`,
    name: profile?.name ?? siteConfig.author,
    url: siteUrl("/"),
    jobTitle: profile?.jobTitle,
    description: siteConfig.description,
    sameAs,
    knowsAbout: [
      "Python",
      "FastAPI",
      "API tasarımı",
      "Asenkron programlama",
      "Dağıtık sistemler",
    ],
  }}
/>

<PageLayout meta={{ title: pageTitle, description: siteConfig.description }}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-main">
      <h1 id="hero-title">
        Kod yazmak başlangıç. <em>Asıl mesele üretim.</em>
      </h1>
      <div class="hero-foot">
        <p>{intro}</p>
      </div>
    </div>

    <aside class="repo-showcase" aria-label="Öne çıkan GitHub projeleri">
      <div class="repo-head">
        <span>Açık kaynak / GitHub</span>
        {
          profile?.github && (
            <a
              href={`${profile.github}?tab=repositories`}
              rel="noreferrer"
              target="_blank"
            >
              Tümü ↗
            </a>
          )
        }
      </div>
      <div
        class="repo-list"
        id="github-repos"
        aria-live="polite"
        aria-busy="true"
      >
        <p class="repo-loading">Projeler GitHub’dan geliyor…</p>
      </div>
      <template id="github-repo-template">
        <a class="repo-card" rel="noopener noreferrer" target="_blank">
          <div class="repo-card-top">
            <span data-repo-index></span>
            <span aria-hidden="true">↗</span>
          </div>
          <h2 data-repo-name></h2>
          <p data-repo-description></p>
          <span class="repo-stack" data-repo-meta></span>
        </a>
      </template>
      <template id="github-repo-error">
        <p class="repo-loading">
          Projeler şu anda yüklenemedi. <a
            href="https://github.com/erhan?tab=repositories"
            rel="noopener noreferrer"
            target="_blank">GitHub’da görüntüle ↗</a
          >
        </p>
      </template>
    </aside>
  </section>

  <section class="writing" aria-labelledby="writing-title">
    <header class="section-head">
      <div>
        <p class="section-kicker">
          Yazı arşivi / {String(allPosts.length).padStart(2, "0")}
        </p>
        <h2 id="writing-title">Yeni notlar</h2>
      </div>
      <a data-astro-prefetch href={withBase("/posts/")}
        >Bütün yazılar <span aria-hidden="true">↗</span></a
      >
    </header>

    <div class="post-grid">
      {
        featured && (
          <article class="lead-post">
            <a
              class="post-link"
              data-astro-prefetch
              href={withBase(`/posts/${featured.id}/`)}
            >
              <div class="post-topline">
                <span>01 / Yeni</span>
                <time datetime={getPostSortDate(featured).toISOString()}>
                  {formatStampDate(getPostSortDate(featured))}
                </time>
              </div>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.description}</p>
              <div class="post-bottomline">
                <span>{featured.data.tags?.slice(0, 3).join(" · ")}</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
            </a>
          </article>
        )
      }

      <div class="post-list">
        {
          rest.map((post, index) => (
            <article class="post-row">
              <a data-astro-prefetch href={withBase(`/posts/${post.id}/`)}>
                <div class="post-index">
                  {String(index + 2).padStart(2, "0")}
                </div>
                <div>
                  <time datetime={getPostSortDate(post).toISOString()}>
                    {formatRailDate(getPostSortDate(post))}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(260px, 0.8fr);
    border-bottom: 2px solid hsl(var(--theme-text));
    margin-bottom: clamp(72px, 10vw, 132px);
  }
  .hero-main {
    padding: 0 clamp(30px, 5vw, 76px) clamp(52px, 7vw, 92px) 0;
  }
  .section-kicker,
  .post-topline,
  .repo-head {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 11ch;
    margin: 0 0 clamp(48px, 6vw, 78px);
    font-family: var(--font-serif);
    font-size: clamp(3.4rem, 8vw, 7.8rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .hero h1 em {
    display: block;
    color: hsl(var(--theme-accent));
    font-weight: 400;
  }
  .hero-foot {
    display: block;
  }
  .hero-foot > p {
    max-width: 58ch;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.62;
    color: hsl(var(--theme-text-muted));
    text-wrap: pretty;
  }
  .repo-showcase {
    display: flex;
    flex-direction: column;
    min-height: 520px;
    padding: 28px clamp(20px, 2.8vw, 38px) 30px;
    background: var(--repo-surface);
    color: var(--repo-ink);
  }
  .repo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  }
  .repo-head a {
    color: inherit;
    border-bottom: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    transition: opacity 180ms ease;
  }
  .repo-head a:hover {
    opacity: 0.64;
  }
  .repo-list {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  .repo-loading {
    margin: auto 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }
  .repo-loading a {
    border-bottom: 1px solid color-mix(in srgb, currentColor 45%, transparent);
  }
  .repo-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 0 18px;
    border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }
  .repo-card:last-child {
    border-bottom: 0;
  }
  .repo-card-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    opacity: 0.58;
  }
  .repo-card h2 {
    margin: 10px 0 6px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.2vw, 34px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .repo-card p {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    opacity: 0.72;
    text-wrap: pretty;
  }
  .repo-stack {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .repo-card:hover {
    transform: translateX(5px);
    opacity: 0.72;
  }
  .writing {
    margin-bottom: 112px;
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 32px;
  }
  .section-kicker {
    margin: 0 0 10px;
    color: hsl(var(--theme-accent));
  }
  .section-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .section-head > a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 4px;
  }
  .section-head > a:hover {
    color: hsl(var(--theme-accent));
    border-color: hsl(var(--theme-accent));
  }
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    border-top: 2px solid hsl(var(--theme-text));
    border-bottom: 1px solid var(--hairline);
  }
  .lead-post {
    border-right: 1px solid var(--hairline);
  }
  .post-link {
    display: flex;
    min-height: 430px;
    flex-direction: column;
    padding: 28px clamp(28px, 4vw, 52px) 32px 0;
  }
  .post-topline {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: hsl(var(--theme-text-muted));
  }
  .post-link h3,
  .post-row h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .post-link h3 {
    max-width: 12ch;
    margin: auto 0 24px;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 0.98;
  }
  .post-link > p {
    max-width: 54ch;
    margin: 0 0 32px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: hsl(var(--theme-text-muted));
  }
  .post-bottomline {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--theme-text-muted));
  }
  .arrow {
    color: hsl(var(--theme-accent));
    font-size: 20px;
    line-height: 1;
    transition: transform 180ms ease;
  }
  .post-link:hover h3,
  .post-row a:hover h3 {
    color: hsl(var(--theme-accent));
  }
  .post-link:hover .arrow,
  .post-row a:hover .arrow {
    transform: translate(4px, -4px);
  }
  .post-list {
    display: flex;
    flex-direction: column;
  }
  .post-row {
    flex: 1;
    border-bottom: 1px solid var(--hairline);
  }
  .post-row:last-child {
    border-bottom: 0;
  }
  .post-row a {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
    height: 100%;
    padding: 26px 0 24px clamp(24px, 3.5vw, 44px);
  }
  .post-index,
  .post-row time {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: hsl(var(--theme-text-muted));
  }
  .post-index {
    color: hsl(var(--theme-accent));
  }
  .post-row h3 {
    margin: 10px 0 8px;
    font-size: clamp(22px, 2.3vw, 31px);
    line-height: 1.06;
  }
  .post-row p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.5;
    color: hsl(var(--theme-text-muted));
  }
  .post-row .arrow {
    padding-right: 4px;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-main {
      padding-right: 0;
    }
    .repo-showcase {
      min-height: auto;
    }
    .repo-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .repo-card {
      min-height: 220px;
      padding-right: 22px;
      border-right: 1px solid color-mix(in srgb, currentColor 28%, transparent);
      border-bottom: 0;
    }
    .repo-card + .repo-card {
      padding-left: 22px;
    }
    .repo-card:last-child {
      border-right: 0;
      padding-right: 0;
    }
    .post-grid {
      grid-template-columns: 1fr;
    }
    .lead-post {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
    .post-link {
      min-height: 380px;
      padding-right: 0;
    }
    .post-row a {
      padding-left: 0;
    }
  }
  @media (max-width: 620px) {
    .hero h1 {
      font-size: clamp(3.15rem, 16vw, 5.3rem);
    }
    .repo-showcase {
      margin: 0 -22px;
      padding-inline: 22px;
    }
    .repo-list {
      display: flex;
    }
    .repo-card {
      min-height: 0;
      padding: 22px 0 18px;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    }
    .repo-card + .repo-card {
      padding-left: 0;
    }
    .repo-card:last-child {
      border-bottom: 0;
    }
    .section-head {
      align-items: start;
    }
    .section-head > a {
      margin-top: 10px;
    }
    .post-link {
      min-height: 340px;
    }
    .post-link h3 {
      font-size: 39px;
    }
    .post-row a {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 12px;
    }
    .post-row p {
      -webkit-line-clamp: 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .repo-card {
      transition: none;
    }
  }
</style>

<script>
  interface GitHubRepo {
    archived: boolean;
    description: string | null;
    fork: boolean;
    html_url: string;
    language: string | null;
    name: string;
    private: boolean;
    pushed_at: string;
    stargazers_count: number;
  }

  const repoList = document.getElementById("github-repos");
  const repoTemplate = document.getElementById(
    "github-repo-template",
  ) as HTMLTemplateElement | null;
  const errorTemplate = document.getElementById(
    "github-repo-error",
  ) as HTMLTemplateElement | null;

  const renderRepo = (repo: GitHubRepo, index: number) => {
    const card = repoTemplate?.content.firstElementChild?.cloneNode(
      true,
    ) as HTMLAnchorElement | null;
    if (!card) return null;

    card.href = repo.html_url;
    const indexElement = card.querySelector<HTMLElement>("[data-repo-index]");
    const nameElement = card.querySelector<HTMLElement>("[data-repo-name]");
    const descriptionElement = card.querySelector<HTMLElement>(
      "[data-repo-description]",
    );
    const metaElement = card.querySelector<HTMLElement>("[data-repo-meta]");

    if (indexElement)
      indexElement.textContent = String(index + 1).padStart(2, "0");
    if (nameElement) nameElement.textContent = repo.name;
    if (descriptionElement) {
      descriptionElement.textContent =
        repo.description ?? "GitHub’daki açık kaynak projelerimden biri.";
    }
    if (metaElement) {
      metaElement.textContent =
        [
          repo.language,
          repo.stargazers_count > 0 ? `★ ${repo.stargazers_count}` : null,
        ]
          .filter(Boolean)
          .join(" · ") || "Açık kaynak";
    }

    return card;
  };

  const loadRepos = async () => {
    if (!repoList) return;

    try {
      const response = await fetch(
        "https://api.github.com/users/erhan/repos?type=owner&sort=pushed&direction=desc&per_page=100",
        {
          headers: {
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
          },
        },
      );
      if (!response.ok) throw new Error(`GitHub API: ${response.status}`);

      const repos = ((await response.json()) as GitHubRepo[])
        .filter(
          (repo) =>
            !repo.private &&
            !repo.archived &&
            !repo.fork &&
            repo.name.toLowerCase() !== "erhan.dev",
        )
        .sort(
          (a, b) =>
            new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime(),
        )
        .slice(0, 3);

      const cards = repos.map(renderRepo).filter((card) => card !== null);
      if (cards.length === 0)
        throw new Error("Gösterilecek public repo bulunamadı");
      repoList.replaceChildren(...cards);
    } catch {
      const fallback =
        errorTemplate?.content.firstElementChild?.cloneNode(true);
      if (fallback) repoList.replaceChildren(fallback);
    } finally {
      repoList.setAttribute("aria-busy", "false");
    }
  };

  void loadRepos();
</script>
